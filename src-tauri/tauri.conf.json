{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KIO Usage Monitor",
  "version": "0.1.0",
  "identifier": "vn.kiodigital.usagemonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KIO Usage Monitor",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local-first AI usage monitor",
    "longDescription": "Monitor supported local usage signals from AI developer tools without a cloud backend.",
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
